# GPU build: ROCm base + ROS 2 Jazzy + ONNX Runtime MIGraphX EP.
# Target: ROCm 7.2.x + gfx1150 (Radeon 890M, Strix Point).
FROM rocm/dev-ubuntu-24.04:7.2.1

ENV ROS_DISTRO=jazzy
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        locales curl ca-certificates gnupg lsb-release software-properties-common \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 \
    && add-apt-repository universe \
    && curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0xAD19BAB3CBF125EA" \
        | gpg --dearmor -o /usr/share/keyrings/ros-snapshots.gpg \
    && rm -f /etc/apt/sources.list.d/ros2.list /etc/apt/sources.list.d/ros2-latest.list \
    && printf 'Types: deb\nURIs: http://snapshots.ros.org/jazzy/2026-04-13/ubuntu\nSuites: noble\nComponents: main\nSigned-By: /usr/share/keyrings/ros-snapshots.gpg\n' \
        > /etc/apt/sources.list.d/ros2.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-vision-msgs \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-sensor-msgs \
        python3-colcon-common-extensions \
        python3-opencv \
        python3-pip \
        migraphx \
        half \
    && rm -rf /var/lib/apt/lists/*

# AMD's ROCm 7.2.1 manylinux wheel directory publishes ONNX Runtime with MIGraphX EP.
# Do not silently fall back to CPU in the GPU image; a missing MIGraphX provider
# should fail the image build or startup so GPU validation is honest.
RUN pip install --no-cache-dir --break-system-packages \
        numpy==1.26.4 \
        onnxruntime-migraphx==1.23.2 \
        -f https://repo.radeon.com/rocm/manylinux/rocm-rel-7.2.1/

RUN python3 -c "import onnxruntime as ort; providers = ort.get_available_providers(); print('ONNX Runtime providers:', providers); assert 'MIGraphXExecutionProvider' in providers, 'MIGraphXExecutionProvider is not available'"

WORKDIR /workspaces/eto_eye_ws
COPY robot_ws/src/eto_eye ./src/eto_eye

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && colcon build --packages-select eto_eye --symlink-install

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
    && echo "source /workspaces/eto_eye_ws/install/setup.bash" >> /root/.bashrc

CMD ["bash", "-c", "source /opt/ros/${ROS_DISTRO}/setup.bash && source install/setup.bash && ros2 launch eto_eye eto_eye.launch.py"]
