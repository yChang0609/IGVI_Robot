FROM ghcr.io/screamlab/wildbot_base_image:latest
ENV ROS_DISTRO=jazzy
ENV DEBIAN_FRONTEND=noninteractive

# Keep ROS packages on the same snapshot used by the robot images.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg && \
    curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0xAD19BAB3CBF125EA" \
      | gpg --dearmor -o /usr/share/keyrings/ros-snapshots.gpg && \
    rm -f /etc/apt/sources.list.d/ros2.list /etc/apt/sources.list.d/ros2-latest.list && \
    printf 'Types: deb\nURIs: http://snapshots.ros.org/jazzy/2026-04-13/ubuntu\nSuites: noble\nComponents: main\nSigned-By: /usr/share/keyrings/ros-snapshots.gpg\n' \
      > /etc/apt/sources.list.d/ros2.sources && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get -y dist-upgrade

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-opencv \
        ros-${ROS_DISTRO}-vision-msgs \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-image-geometry \
        ros-${ROS_DISTRO}-tf2-ros \
        ros-${ROS_DISTRO}-tf2-geometry-msgs \
        ros-${ROS_DISTRO}-message-filters \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --break-system-packages \
        onnxruntime==1.20.1 \
        numpy

WORKDIR /workspaces/eto_eye_ws
COPY robot_ws/src/eto_eye ./src/eto_eye

RUN . /opt/ros/${ROS_DISTRO}/setup.sh \
    && colcon build --packages-select eto_eye --symlink-install

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
    && echo "source /workspaces/eto_eye_ws/install/setup.bash" >> /root/.bashrc

CMD ["bash", "-c", "source /opt/ros/${ROS_DISTRO}/setup.bash && source install/setup.bash && ros2 launch eto_eye eto_eye.launch.py"]
