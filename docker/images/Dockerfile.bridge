FROM ros:jazzy-ros-base

# --- Pin ROS 2 apt to a fixed, internally-consistent snapshot (2026-04-13) ---
# Prevents the Fast-CDR/typesupport ABI mismatch (undefined
# eprosima::fastcdr::Cdr::serialize* -> exit 127 when serializing ROS msgs).
# Snapshot repo is signed by ROS Snapshot builder key 0xAD19BAB3CBF125EA.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg && \
    curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&options=mr&search=0xAD19BAB3CBF125EA" \
      | gpg --dearmor -o /usr/share/keyrings/ros-snapshots.gpg && \
    rm -f /etc/apt/sources.list.d/ros2.list /etc/apt/sources.list.d/ros2-latest.list && \
    printf 'Types: deb\nURIs: http://snapshots.ros.org/jazzy/2026-04-13/ubuntu\nSuites: noble\nComponents: main\nSigned-By: /usr/share/keyrings/ros-snapshots.gpg\n' \
      > /etc/apt/sources.list.d/ros2.sources && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get -y dist-upgrade

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ros-jazzy-nav-msgs \
        ros-jazzy-nav2-msgs \
        ros-jazzy-geometry-msgs \
        ros-jazzy-sensor-msgs \
        ros-jazzy-trajectory-msgs \
        ros-jazzy-tf2-ros \
        ros-jazzy-rosidl-default-generators \
        ros-jazzy-rosidl-default-runtime \
        ros-jazzy-action-msgs \
        python3-colcon-common-extensions \
        python3-pil \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY robot_ws/src/igvi_bridge src/igvi_bridge
# wildbot_grasp's action types are built into the bridge image so the bridge
# can dispatch the /open_door goal from the UI without shelling out.
COPY robot_ws/src/wildbot_grasp src/wildbot_grasp

RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --packages-select wildbot_grasp igvi_bridge --symlink-install

CMD ["/bin/bash", "-c", \
     "source /opt/ros/jazzy/setup.bash && \
      source /workspace/install/setup.bash && \
      ros2 run igvi_bridge bridge_node"]
