ROS_DOMAIN_ID=0
FASTRTPS_DEFAULT_PROFILES_FILE=/configs/fastdds_shm.xml
IGVI_DATA_ROOT=~/igvi_robot

# Bear grasp distance gate.
BEAR_TARGET_MAX_DISTANCE_M=0.24
BEAR_TARGET_CENTER_X_PX=690.0
# 0 means unlimited task-level retries; each /grab_object call still tries GRASP_MAX_ATTEMPTS internally.
BEAR_MAX_TASK_RETRIES=0

# Gripper grasp detection. These are passed into grab_object_server by grasp_stack.
GRASP_DETECT_MIN_ERROR_DEG=2.5
GRASP_DETECT_MIN_CLOSE_MOTION_DEG=5.0
# false means keep holding the object in carry_pose_deg after a successful grasp.
GRASP_RELEASE_AFTER_GRASP=false
