ROS_DOMAIN_ID=0
FASTRTPS_DEFAULT_PROFILES_FILE=/configs/fastdds_shm.xml
IGVI_DATA_ROOT=~/igvi_robot

# Bear grasp distance gate.
BEAR_TARGET_MAX_DISTANCE_M=0.24
BEAR_TARGET_CENTER_X_PX=690.0
# 0 means unlimited task-level retries; each /grab_object call still tries GRASP_MAX_ATTEMPTS internally.
BEAR_MAX_TASK_RETRIES=0

# Semantic memory deduplication: objects within this radius (metres) of an existing
# entry update its position instead of creating a new one.
SEMANTIC_MERGE_RADIUS_M=0.4

# Visual servo (search_retrieve_server and bridge_retrieve_server).
# Kinect RGB is 1280x720; image_center_x should be 640 (horizontal centre).
# Increase RETRIEVE_IMAGE_CENTER_X above 640 to shift the aim point right,
# compensating for gripper offset relative to camera optical axis.
RETRIEVE_IMAGE_CENTER_X=640.0
RETRIEVE_CENTER_TOLERANCE_PX=25.0
RETRIEVE_VISUAL_SERVO_KP=0.005
RETRIEVE_STANDOFF_DISTANCE=0.45
RETRIEVE_APPROACH_DISTANCE_M=0.24
RETRIEVE_APPROACH_SPEED=0.05
RETRIEVE_APPROACH_TIMEOUT_SEC=20.0

# Navigation arrival check (both retrieve servers).
RETRIEVE_ARRIVAL_TOLERANCE=0.10
RETRIEVE_ARRIVAL_TIMEOUT_SEC=45.0

# bridge_retrieve_server specific.
BRIDGE_TARGET_CLASS=xiong_qiao
# Memory point within this radius (m) of the bridge waypoint => face it; else scan-rotate.
BRIDGE_MEMORY_RADIUS_M=0.6
# In-place scan to find the bear when no memory point is near: CW 45 -> CCW 90 -> keep turning.
BRIDGE_SCAN_ANGULAR_SPEED=0.4
BRIDGE_SCAN_STEP_TIMEOUT_SEC=15.0
BRIDGE_SCAN_TOTAL_TIMEOUT_SEC=40.0

# Gripper grasp detection. These are passed into grab_object_server by grasp_stack.
GRASP_DETECT_MIN_ERROR_DEG=2.5
GRASP_DETECT_MIN_CLOSE_MOTION_DEG=5.0
# false means keep holding the object in carry_pose_deg after a successful grasp.
GRASP_RELEASE_AFTER_GRASP=false
