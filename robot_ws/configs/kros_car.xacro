  -->

  <ros2_control name="kros_car_system" type="system">
    <hardware>
      <plugin>kros_car/KrosCarSystem</plugin>
      <param name="wheel_port">$(arg wheel_port)</param>
      <param name="wheel_baudrate">$(arg wheel_baudrate)</param>
      <param name="wheel_motor_ids">$(arg wheel_motor_ids)</param>
      <param name="wheel_motor_directions">$(arg wheel_motor_directions)</param>
      <param name="max_rpm">$(arg max_rpm)</param>
      <param name="acceleration_act">$(arg acceleration_act)</param>
      <param name="arm_port">$(arg arm_port)</param>
      <param name="arm_baudrate">$(arg arm_baudrate)</param>
      <param name="arm_servo_ids">$(arg arm_servo_ids)</param>
      <param name="default_move_time_ms">$(arg default_move_time_ms)</param>
      <param name="arm_read_timeout_ms">$(arg arm_read_timeout_ms)</param>
      <param name="arm_temp_publish_interval_cycles">$(arg arm_temp_publish_interval_cycles)</param>
      <param name="gripper_max_ticks">$(arg gripper_max_ticks)</param>
      <param name="gripper_stall_error_ticks">$(arg gripper_stall_error_ticks)</param>
      <param name="gripper_stall_trigger_ms">$(arg gripper_stall_trigger_ms)</param>
      <param name="gripper_stall_motion_epsilon_ticks">$(arg gripper_stall_motion_epsilon_ticks)</param>
      <param name="gripper_stall_backoff_ticks">$(arg gripper_stall_backoff_ticks)</param>
      <param name="gripper_stall_release_delta_ticks">$(arg gripper_stall_release_delta_ticks)</param>
      <param name="gripper_overheat_temp_c">$(arg gripper_overheat_temp_c)</param>
      <param name="gripper_overheat_hysteresis_c">$(arg gripper_overheat_hysteresis_c)</param>
      <param name="wheel_joints">$(arg wheel_joints)</param>
      <param name="arm_joints">$(arg arm_joints)</param>
    </hardware>

    <joint name="wheel_1_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_2_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_3_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_4_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="arm_1_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="arm_2_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_joint_2">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
