<?xml version="1.0" ?>
<robot name="kros_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="materials.xacro" />
<xacro:arg name="wheel_port" default="/dev/usb_wheel" />
<xacro:arg name="wheel_baudrate" default="115200" />
<xacro:arg name="wheel_motor_ids" default="1,2,3,4" />
<xacro:arg name="wheel_motor_directions" default="1,1,-1,-1" />
