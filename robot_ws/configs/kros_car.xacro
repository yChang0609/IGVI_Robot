<xacro:arg name="gripper_overheat_hysteresis_c" default="5" />
<xacro:arg name="wheel_joints" default="wheel_1_joint,wheel_2_joint,wheel_3_joint,wheel_4_joint" />
<xacro:arg name="arm_joints" default="arm_1_joint,arm_2_joint,gripper_joint" />
