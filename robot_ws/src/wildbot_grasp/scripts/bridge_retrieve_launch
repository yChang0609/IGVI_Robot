#!/usr/bin/env bash
set -euo pipefail

append_param() {
  local -n _ref="$1"
  local env_name="$2"
  local param_name="$3"
  local value="${!env_name:-}"
  if [[ -n "${value}" ]]; then
    _ref+=(-p "${param_name}:=${value}")
  fi
}

ros_args=(--ros-args)
append_param ros_args RETRIEVE_IMAGE_CENTER_X       image_center_x
append_param ros_args RETRIEVE_VISUAL_SERVO_KP      visual_servo_kp
append_param ros_args RETRIEVE_VISUAL_SERVO_TOLERANCE_PX visual_servo_tolerance_px
append_param ros_args RETRIEVE_STANDOFF_DISTANCE    standoff_distance
append_param ros_args RETRIEVE_APPROACH_DISTANCE_M  approach_target_distance_m
append_param ros_args RETRIEVE_APPROACH_SPEED       approach_linear_speed
append_param ros_args RETRIEVE_APPROACH_TIMEOUT_SEC approach_timeout_sec
append_param ros_args BRIDGE_TARGET_CLASS           target_class
append_param ros_args BRIDGE_SEARCH_MEMORY_TIMEOUT  search_memory_timeout

exec ros2 run wildbot_grasp bridge_retrieve_server "${ros_args[@]}"
