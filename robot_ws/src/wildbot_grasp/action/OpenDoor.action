# Vision-guided door-opening FSM.
# The server uses /detections_json from eto_eye (YOLOv8s-seg + depth) to align
# and approach a door knob, then drives the arm to press the handle and pushes
# the base forward to open the door.
string knob_class            # YOLO class_name of the knob (empty → server default)
float32 ready_distance_m     # depth at which to stop approaching, in meters (<=0 → server default)
---
bool success
string message
---
string stage                 # FSM state name (align/approach/press/push/complete/abort)
float32 progress             # 0..1
string detail
